<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playpen+Sans:wght@400;500;600;700&family=Poppins:ital,wght@0,400;0,500;0,600;1,400&display=swap">
<style>
/* Layout: faixas claras alternando branco e azul-petróleo bem suave; um "fio de sinapse" (pontos conectados) liga o hero às seções. Versão sempre clara, sem modo escuro. */
:root {
  color-scheme: light;
  --bg: #FFFFFF;
  --band: #F3F8FA;        /* azul petróleo bem claro */
  --surface: #FFFFFF;
  --fg: #2A2826;
  --muted: #5F5C55;
  --anchor: #0A4D68;      /* azul petróleo */
  --anchor-strong: #083B50;
  --anchor-tint: #E3F0F4;
  --purple: #7B5EA7;      /* roxo ametista */
  --purple-tint: #F2ECF8;
  --line: rgba(10, 77, 104, .12);
  --on-anchor: #FFFFFF;
  --deep: #E6F2F6;        /* faixa de contato */
  --deep-fg: #0A4D68;
  --deep-muted: #4A6B78;

  --font-display: "Playpen Sans", "Comic Sans MS", "Segoe Print", cursive;
  --font-body: "Poppins", "Segoe UI", system-ui, sans-serif;

  --step--1: .875rem;
  --step-0: 1rem;
  --step-1: 1.25rem;
  --step-2: 1.6rem;
  --step-3: clamp(1.9rem, 4vw, 2.5rem);
  --step-4: clamp(2.3rem, 6vw, 3.6rem);
  --radius: 18px;
}

* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--fg);
  font-family: var(--font-body);
  font-size: var(--step-0);
  line-height: 1.7;
}
h1, h2, h3 { font-family: var(--font-display); color: var(--anchor); text-wrap: balance; margin: 0; line-height: 1.2; font-weight: 600; }
p { margin: 0; }
a { color: inherit; }
:focus-visible { outline: 3px solid var(--purple); outline-offset: 3px; border-radius: 6px; }

.wrap {
  max-width: 1080px;
  margin-inline: auto;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
.band { padding-block: clamp(56px, 9vw, 96px); }
.band--alt { background: var(--band); }

.eyebrow {
  font-size: var(--step--1);
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--purple);
}
.lede { color: var(--muted); max-width: 62ch; font-size: 1.05rem; }
.section-head { display: grid; gap: 12px; margin-bottom: 40px; }
.section-head h2 { font-size: var(--step-3); }


/* topo */
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--bg); }
.top {
  position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5;
  background: color-mix(in srgb, var(--bg) 92%, transparent);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--line);
}
.top .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 12px; }
.top img { height: 40px; width: auto; }
.top nav { display: flex; gap: 22px; font-size: .92rem; }
.top nav a { text-decoration: none; color: var(--muted); }
.top nav a:hover { color: var(--anchor); }

.btn {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 12px 22px;
  border-radius: 999px;
  background: var(--anchor);
  color: var(--on-anchor);
  font-weight: 600;
  text-decoration: none;
  font-size: .98rem;
  border: 0; cursor: pointer; font-family: inherit;
  transition: transform .15s ease, background .15s ease;
}
.btn:hover { transform: translateY(-1px); background: var(--anchor-strong); }
.btn svg { width: 20px; height: 20px; flex: none; }
.btn--small { padding: 9px 16px; font-size: .9rem; }
.btn--ghost { background: transparent; color: var(--anchor); box-shadow: inset 0 0 0 2px var(--anchor); }
.btn--ghost:hover { background: var(--anchor-tint); }

/* hero */
.hero { padding-block: clamp(48px, 8vw, 88px) clamp(56px, 8vw, 96px); }
.hero .wrap { display: grid; grid-template-columns: 1.15fr .85fr; gap: 48px; align-items: center; }
.hero-text { display: grid; gap: 22px; min-width: 0; }
.hero h1 { font-size: var(--step-4); }
.hero h1 em { font-style: normal; color: var(--purple); }
.hero .lede { font-size: 1.12rem; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
.hero-name { font-size: .95rem; color: var(--muted); }
.hero-name strong { color: var(--fg); font-weight: 600; }
.synapse { width: 100%; max-width: 420px; justify-self: center; }
.synapse .halo { fill: var(--anchor-tint); }
.synapse .ring { fill: none; stroke: var(--purple); stroke-width: 1.5; stroke-dasharray: 2 9; stroke-linecap: round; opacity: .55; }
.synapse .net { stroke: var(--anchor); stroke-width: 1.2; opacity: .18; fill: none; }
.synapse .net-dot { fill: var(--anchor); opacity: .22; }
.synapse .ln { stroke: var(--anchor); stroke-width: 3.2; fill: none; stroke-linecap: round; }
.synapse .ln-thin { stroke-width: 2.2; }
.synapse .ln-p { stroke: var(--purple); }
.synapse .nd { fill: var(--anchor); }
.synapse .nd-p { fill: var(--purple); }
.synapse .soma { fill: var(--anchor); }
.synapse .soma-p { fill: var(--purple); }
.synapse .nucleus { fill: var(--bg); }
.synapse .terminal { fill: var(--bg); stroke: var(--anchor); stroke-width: 3.2; }
.synapse .spine { fill: var(--bg); stroke: var(--purple); stroke-width: 3.2; }
.synapse .spark { fill: var(--purple); animation: cross 2.4s ease-in-out infinite; }
.synapse .spark:nth-of-type(2) { animation-delay: .8s; }
.synapse .spark:nth-of-type(3) { animation-delay: 1.6s; }
@keyframes cross { 0% { transform: translateX(-6px); opacity: 0; } 30%, 70% { opacity: 1; } 100% { transform: translateX(8px); opacity: 0; } }

/* o que é */
.pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.pillar { background: var(--surface); border-radius: var(--radius); padding: 28px; display: grid; gap: 10px; align-content: start; border: 1px solid var(--line); }
.pillar h3 { font-size: var(--step-1); }
.pillar p { color: var(--muted); font-size: .95rem; }
.pillar-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--purple); box-shadow: 0 0 0 6px var(--purple-tint); margin-bottom: 6px; }
.formula {
  margin-top: 32px;
  font-family: var(--font-display);
  font-size: var(--step-1);
  color: var(--anchor);
  text-align: center;
}
.formula span { color: var(--purple); padding-inline: .3em; }

/* sinais */
.signs { list-style: none; margin: 0 0 32px; padding: 0; display: grid; grid-template-columns: 1fr 1fr; column-gap: 48px; }
.signs li { display: grid; grid-template-columns: 22px 1fr; gap: 12px; padding: 10px 0; border-bottom: 1px dashed var(--line); }
.signs li::before { content: ""; width: 10px; height: 10px; margin-top: .55em; border-radius: 50%; background: var(--anchor); box-shadow: 0 0 0 4px var(--anchor-tint); justify-self: center; }
.diagnoses { margin-top: 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }
.diagnoses p { color: var(--muted); font-size: .95rem; }
.tags { display: flex; flex-wrap: wrap; gap: 8px; }
.tag { padding: 6px 14px; border-radius: 999px; background: var(--purple-tint); color: var(--purple); font-size: .9rem; font-weight: 500; }
.audience { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.audience li { background: var(--band); border-radius: var(--radius); padding: 26px; display: grid; gap: 8px; align-content: start; }
.audience strong { font-family: var(--font-display); font-weight: 600; color: var(--anchor); font-size: var(--step-1); line-height: 1.3; }
.audience span { color: var(--muted); font-size: .95rem; }
.contact-where { font-size: .92rem; color: var(--deep-muted); }
.note { font-size: .92rem; color: var(--muted); background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; }

/* etapas */
.steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; counter-reset: s; position: relative; }
.step { counter-increment: s; display: grid; gap: 10px; align-content: start; position: relative; }
.step::before {
  content: counter(s);
  font-family: var(--font-display); font-weight: 600; font-size: 1.15rem;
  width: 48px; height: 48px; border-radius: 50%;
  display: grid; place-items: center;
  background: var(--anchor); color: var(--on-anchor);
  position: relative; z-index: 1;
}
.steps::before { content: ""; position: absolute; top: 24px; left: 24px; right: 24px; border-top: 2px dotted var(--anchor); opacity: .45; }
.step h3 { font-size: 1.12rem; }
.step p { color: var(--muted); font-size: .94rem; }

/* sobre */
.about { display: grid; grid-template-columns: auto 1fr; gap: 40px; align-items: center; }
.monogram {
  width: 168px; height: 168px; border-radius: 50%;
  display: grid; place-items: center;
  background: var(--anchor-tint);
  color: var(--anchor);
  font-family: var(--font-display); font-size: 3.4rem; font-weight: 600;
  box-shadow: 0 0 0 10px var(--bg), 0 0 0 12px var(--purple);
}
.about-text { display: grid; gap: 14px; min-width: 0; max-width: 64ch; }
.about-text h2 { font-size: var(--step-3); }
.about-text .role { font-weight: 500; color: var(--purple); }

/* faq */
.faq { display: grid; gap: 12px; max-width: 760px; }
.faq details { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 4px 20px; }
.faq summary { cursor: pointer; font-weight: 600; padding: 14px 0; list-style: none; display: flex; justify-content: space-between; gap: 16px; color: var(--fg); }
.faq summary::-webkit-details-marker { display: none; }
.faq summary::after { content: "+"; font-family: var(--font-display); color: var(--purple); font-size: 1.4rem; line-height: 1; }
.faq details[open] summary::after { content: "−"; }
.faq details p { padding-bottom: 16px; color: var(--muted); font-size: .96rem; }

/* contato */
.contact { background: var(--deep); color: var(--deep-fg); }
.contact .wrap { display: grid; grid-template-columns: 1.1fr .9fr; gap: 40px; align-items: center; }
.contact h2 { color: var(--deep-fg); font-size: var(--step-3); }
.contact .lede { color: var(--deep-muted); margin-top: 14px; }
.contact-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; display: grid; gap: 16px; box-shadow: 0 10px 30px rgba(10, 77, 104, .08); }
.contact-card .label { font-size: var(--step--1); letter-spacing: .08em; text-transform: uppercase; color: var(--deep-muted); font-weight: 600; }
.phone { color: var(--anchor); font-family: var(--font-display); font-size: clamp(1.6rem, 4vw, 2.1rem); font-weight: 600; user-select: all; font-variant-numeric: tabular-nums; }
.contact-actions { display: flex; flex-wrap: wrap; gap: 10px; }
.copied { font-size: .88rem; color: var(--deep-muted); min-height: 1.4em; }

footer { background: var(--bg); color: var(--muted); border-top: 1px solid var(--line); }
footer .wrap { padding-block: 28px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; font-size: .88rem; }
footer img { height: 34px; width: auto; }

@media (max-width: 860px) {
  .top nav { display: none; }
  .hero .wrap, .signs, .audience, .contact .wrap { grid-template-columns: 1fr; }
  .synapse { max-width: 300px; order: -1; }
  .pillars { grid-template-columns: 1fr; }
  .steps { grid-template-columns: 1fr 1fr; row-gap: 32px; }
  .steps::before { display: none; }
}
@media (max-width: 560px) {
  .steps { grid-template-columns: 1fr; }
  .about { grid-template-columns: 1fr; justify-items: start; }
  .monogram { width: 120px; height: 120px; font-size: 2.5rem; }
  .top .btn span { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  .synapse .spark { animation: none; }
  .btn { transition: none; }
}
</style>
</head>
